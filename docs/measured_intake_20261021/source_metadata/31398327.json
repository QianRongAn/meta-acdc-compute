ationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Genetics, Department of Medicine, Howard Hughes Medical Institute, Brigham and Women's Hospital, Boston, MA 02115, USA; Department of Genetics, Harvard University Medical School, Boston, MA, USA; Department of Pathology, Massachusetts General Hospital, Boston, MA, USA."}]}},{"fullName":"Abdelfattah NS","lastName":"Abdelfattah","firstName":"Nouran S","initials":"NS","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Genetics, Department of Medicine, Howard Hughes Medical Institute, Brigham and Women's Hospital, Boston, MA 02115, USA; Department of Genetics, Harvard University Medical School, Boston, MA, USA."}]}},{"fullName":"Hartman ZC","lastName":"Hartman","firstName":"Zachary C","initials":"ZC","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Departments of Surgery and Pathology, Duke University Medical Center, 571 Research Drive, Suite 433, Box 2606, Durham, NC 27710, USA."}]}},{"fullName":"Wucherpfennig KW","lastName":"Wucherpfennig","firstName":"Kai W","initials":"KW","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Cancer Immunology and Virology, Dana-Farber Cancer Institute, Department of Immunobiology, Harvard Medical School, Boston, MA 02115, USA."}]}},{"fullName":"Lyerly HK","lastName":"Lyerly","firstName":"Herbert Kim","initials":"HK","authorId":{"type":"ORCID","value":"0000-0002-0063-4770"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Departments of Surgery, Immunology, and Pathology, Duke University Medical Center, 571 Research Drive, Suite 433, Box 2606, Durham, NC 27710, USA."}]}},{"fullName":"Elledge SJ","lastName":"Elledge","firstName":"Stephen J","initials":"SJ","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Genetics, Department of Medicine, Howard Hughes Medical Institute, Brigham and Women's Hospital, Boston, MA 02115, USA; Department of Genetics, Harvard University Medical School, Boston, MA, USA. Electronic address: selledge@genetics.med.harvard.edu."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-9979-5365"},{"type":"ORCID","value":"0000-0002-0063-4770"},{"type":"ORCID","value":"0000-0002-6458-9833"},{"type":"ORCID","value":"0009-0005-6119-4018"},{"type":"ORCID","value":"0009-0006-0866-8816"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data","protocols","recommended_reviews"]},"journalInfo":{"issue":"4","volume":"178","journalIssueId":2847541,"dateOfPublication":"2019 Aug","monthOfPublication":8,"yearOfPublication":2019,"journal":{"medlineAbbreviation":"Cell","title":"Cell","essn":"1097-4172","issn":"0092-8674","isoabbreviation":"Cell","nlmid":"0413066"},"printPublicationDate":"2019-08-01"},"pubYear":"2019","pageInfo":"1016-1028.e13","abstractText":"T cell recognition of specific antigens mediates protection from pathogens and controls neoplasias, but can also cause autoimmunity. Our knowledge of T cell antigens and their implications for human health is limited by the technical limitations of T cell profiling technologies. Here, we present T-Scan, a high-throughput platform for identification of antigens productively recognized by T cells. T-Scan uses lentiviral delivery of antigen libraries into cells for endogenous processing and presentation on major histocompatibility complex (MHC) molecules. Target cells functionally recognized by T cells are isolated using a reporter for granzyme B activity, and the antigens mediating recognition are identified by next-generation sequencing. We show T-Scan correctly identifies cognate antigens of T cell receptors (TCRs) from viral and human genome-wide libraries. We apply T-Scan to discover new viral antigens, perform high-resolution mapping of TCR specificity, and characterize the reactivity of a tumor-derived TCR. T-Scan is a powerful approach for studying T cell responses.","affiliation":"Division of Genetics, Dep